APP_NAME=Royal Dutch Medical Centre API
APP_ENV=production
PYTHON_VERSION=3.11.9
API_V1_PREFIX=/api

DATABASE_URL=mysql+pymysql://USER:PASSWORD@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/royaldutch
DATABASE_SSL=true
DATABASE_SSL_CA_PATH=
DATABASE_SSL_VERIFY_IDENTITY=true

SECRET_KEY=replace-with-strong-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440

BACKEND_CORS_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000,http://127.0.0.1:3000
BACKEND_CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# Render's free (and many paid) plans restrict outbound SMTP, so email is
# sent via the Resend HTTP API when this key is set. SMTP below is only a
# fallback if RESEND_API_KEY is left blank.
RESEND_API_KEY=your-resend-api-key

SMTP_HOST=mail.ayatiworks.com
SMTP_PORT=465
SMTP_USERNAME=emailsmtp@ayatiworks.com
SMTP_USER=emailsmtp@ayatiworks.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=emailsmtp@ayatiworks.com
SMTP_FROM_NAME=Royal Dutch Medical Centre
SMTP_USE_SSL=true
ENABLE_IN_PROCESS_WORKER=true
